rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Multi-tenant data isolation architecture for pz8-manager:
    //
    // Collection: /users/{userId}
    //   Represents the user's account root document where userId corresponds
    //   strictly to Firebase Authentication UID (request.auth.uid).
    //
    // Subcollections under /users/{userId}:
    //
    // 1. /users/{userId}/clients/{clientId}
    //    Represents client subscriptions and customer accounts managed by the tenant.
    //    Fields:
    //      - user: string (required) - account/client username identifier
    //      - contactName: string (optional) - personal name of contact
    //      - phone: string (optional) - telephone/WhatsApp contact
    //      - expirationDate: string (required) - expiration date (YYYY-MM-DD)
    //      - monthlyCost: number (required/optional) - monthly fee in EUR
    //      - isActive: bool (required/optional) - whether subscription is active
    //      - totalCreditsUsed: number (optional) - cumulative credits consumed
    //      - notes: string (optional) - additional notes or device information
    //      - createdAt: string/timestamp (optional) - creation timestamp
    //      - lastRenewal: map or null (optional) - last renewal transaction info
    //
    // 2. /users/{userId}/profile/{docId} (e.g. 'data')
    //    Represents tenant billing profile, credit balances, and transaction ledger.
    //    Fields:
    //      - email: string (optional) - user contact email
    //      - displayName: string (optional) - user display name
    //      - creditsBalance: number (required) - balance of available credits
    //      - creditCostUnit: number (optional) - cost unit per credit
    //      - history: list of maps (optional) - purchase/usage transaction ledger
    //
    // 3. /users/{userId}/settings/{docId} (e.g. 'data')
    //    Represents per-user application preferences.
    //    Fields:
    //      - visibleColumns: map (optional) - UI column display configurations
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is the designated owner of this tenant path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Security Rules
    // ===============================================================

    // Root default deny: Deny all reads and writes across all paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Multi-tenant User Space:
    // - Each user can only read and write their own data under /users/{userId}/...
    // - Only authenticated users (request.auth != null && request.auth.uid == userId)
    //   can read and write to /users/{userId}/{document=**}
    // - Denies all public or unauthenticated access.
    // - Completely isolates tenants so no user can view or alter other users' clients or profiles.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
